      </div>
      <div class="contato-item">
        <div class="contato-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg></div>
        <div><span class="contato-label">{{ 'Horário'|t }}</span>{{ 'Seg. a Sex., 07h30 às 19h30'|t }}</div>
      </div>
      <div class="contato-item">
        <div class="contato-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg></div>
        <div><span class="contato-label">E-mail</span><a href="mailto:detg@ufba.br" style="color:var(--blue6);">detg@ufba.br</a></div>
      </div>
    </div>

    {# Blocos do Drupal na sidebar direita (se houver) #}
    {% if page.sidebar_second %}{{ page.sidebar_second }}{% endif %}

  </aside>

</div>{# /page-main #}

{# ══ RODAPÉ ══════════════════════════════════════════════════ #}
<footer id="main-footer" role="contentinfo">
  <div class="footer-grid">
    <div class="footer-col footer-col--about">
      <div class="footer-logo">
        <svg viewBox="0 0 60 60" width="48" height="48" aria-hidden="true">
          <circle cx="30" cy="30" r="28" fill="rgba(255,255,255,.1)" stroke="rgba(255,255,255,.25)" stroke-width="1.5"/>
          <text x="30" y="27" text-anchor="middle" fill="white" font-size="11" font-weight="900" font-family="Inter,Arial,sans-serif" letter-spacing="1">DETG</text>
          <text x="30" y="39" text-anchor="middle" fill="rgba(255,255,255,.6)" font-size="7" font-family="Inter,Arial,sans-serif" letter-spacing="2">UFBA</text>
