{# ══ BARRA DO GOVERNO FEDERAL — sempre visível ═══════════════ #}
<div id="barra-brasil" style="background:#7f7f7f;height:20px;padding:0 0 0 10px;display:block;"></div>
<script src="https://barra.brasil.gov.br/barra_2.0.js" type="text/javascript"></script>

{# ══ CABEÇALHO — sem logo, título à direita ══════════════════ #}
<header id="main-header">
  <div class="relative z-10 container-wide px-4 flex flex-col md:flex-row items-center justify-center md:justify-end gap-4 py-6">
    <div class="text-center md:text-right max-w-4xl pointer-events-auto flex flex-col items-center md:items-end">
      <h1 class="text-2xl md:text-4xl font-black text-slate-900 leading-tight">
        {{ 'Departamento de Engenharia de'|t }}<br>
        <span class="gradient-text">{{ 'Transportes'|t }}</span> <span class="connector-text mx-1">{{ 'e'|t }}</span> <span class="earth-text">{{ 'Geodésia'|t }}</span>
      </h1>
      <p class="text-slate-600 mt-2 text-base md:text-lg font-medium">{{ 'Universidade Federal da Bahia - Escola Politécnica'|t }}</p>
    </div>
  </div>
</header>

{# ══ MENU PRINCIPAL ══════════════════════════════════════════ #}
<nav id="main-nav" role="navigation" aria-label="{{ 'Menu principal'|t }}">
  <div class="container-wide px-4 py-1">

    <div class="flex items-center justify-between lg:hidden py-2">
      <span class="text-white font-bold tracking-wider text-sm flex items-center gap-2">MENU</span>
      <button id="mobile-menu-btn" class="text-white p-2 hover:bg-blue-700 rounded focus:outline-none focus:ring-2 focus:ring-white" aria-expanded="false" aria-controls="mobile-menu-content" aria-label="{{ 'Abrir menu'|t }}">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>

    <div id="mobile-menu-content" class="hidden lg:flex flex-col lg:flex-row items-center justify-center relative pb-4 lg:pb-0"> 

      <ul class="flex flex-col lg:flex-row items-center justify-center w-full lg:w-auto text-sm md:text-base uppercase gap-y-1 lg:gap-y-0">
        <li class="w-full lg:w-auto"><a href="{{ path('<front>') }}" class="nav-item is-active" title="{{ 'Início'|t }}">Início</a></li>
        <li class="w-full lg:w-auto"><a href="#institucional" class="nav-item">{{ 'Institucional'|t }}</a></li>
        <li class="w-full lg:w-auto"><a href="#docentes" class="nav-item">{{ 'Docentes'|t }}</a></li>
        <li class="w-full lg:w-auto"><a href="#producao" class="nav-item">{{ 'Produção'|t }}</a></li>
        <li class="w-full lg:w-auto"><a href="#laboratorios" class="nav-item">{{ 'Laboratórios'|t }}</a></li>
        <li class="w-full lg:w-auto"><a href="/noticias" class="nav-item">{{ 'Notícias'|t }}</a></li>
      </ul>

      <div class="relative w-full lg:w-64 flex-shrink-0 lg:absolute lg:right-4 mt-3 lg:mt-0 mb-2 lg:mb-0 px-4 lg:px-0">
        <div class="relative flex items-center w-full h-8 rounded-full bg-blue-800/50 border border-blue-400/30 overflow-hidden focus-within:ring-2 focus-within:ring-white/50 transition-all">
          <div class="grid place-items-center h-full w-8 text-blue-200">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <input
          class="peer h-full w-full outline-none text-xs text-white pr-2 bg-transparent placeholder-blue-200/70"
          type="text"
          id="search_menu"
          placeholder="BUSCAR..." />
        </div>
      </div>

    </div>
  </div>
</nav>

{# ══ GRADE 3 COLUNAS ═════════════════════════════════════════
   sidebar-first | main-content | sidebar-second
   ══════════════════════════════════════════════════════════ #}
<div id="page-main">

  {# ── COL 1: LATERAL ESQUERDA ──────────────────────────── #}
  <aside id="sidebar-first" role="complementary" aria-label="{{ 'Sistemas e secretaria'|t }}">

    <div class="detg-widget">
      <h3 class="detg-widget-title">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
        </svg>
        {{ 'Sistemas'|t }}
      </h3>
      <a href="https://sigaa.ufba.br" target="_blank" rel="noopener" class="widget-link">
        <span class="widget-link-title">SIGAA</span>
        <span class="widget-link-sub">{{ 'Sistema Acadêmico'|t }}</span>
      </a>
      <a href="https://moodle.ufba.br" target="_blank" rel="noopener" class="widget-link">
        <span class="widget-link-title">Moodle</span>
        <span class="widget-link-sub">{{ 'Ambiente Virtual'|t }}</span>
      </a>
      <div class="widget-divider"></div>
      <a href="#" class="widget-link">{{ 'Reserva de Equipamentos'|t }}</a>
      <a href="#" class="widget-link">{{ 'Reserva de Laboratórios'|t }}</a>
    </div>

    <div class="detg-widget">
      <h3 class="detg-widget-title">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
        {{ 'Secretaria'|t }}
      </h3>
      <ul class="widget-list">
        <li><a href="#" class="widget-dot-link"><span class="widget-dot"></span>{{ 'Documentos'|t }}</a></li>
        <li><a href="#" class="widget-dot-link"><span class="widget-dot"></span>{{ 'Legislação'|t }}</a></li>
        <li><a href="#" class="widget-dot-link"><span class="widget-dot"></span>{{ 'Formulários'|t }}</a></li>
        <li><a href="#" class="widget-dot-link"><span class="widget-dot"></span>{{ 'Requerimentos'|t }}</a></li>
      </ul>
    </div>

    {# Blocos do Drupal na sidebar esquerda (se houver) #}
    {% if page.sidebar_first %}{{ page.sidebar_first }}{% endif %}

  </aside>

  {# ── COL 2: CONTEÚDO PRINCIPAL ──────────────────────── #}
  <main id="main-content" role="main" tabindex="-1">
    <a id="main-content-anchor" tabindex="-1" aria-hidden="true"></a>

    {# SOBRE O DETG #}
    <section id="institucional" class="detg-section">
      <div class="section-title-container">
        <h2 class="section-title">{{ 'Sobre o DETG'|t }}</h2>
        <div class="section-line"></div>
      </div>
      <div class="card-institutional">
        <p>O <strong>{{ 'Departamento de Engenharia de Transportes e Geodésia - DETG'|t }}</strong>, {{ 'foi criado por iniciativa do Prof. Vasco de Azevedo Neto na década de 1960. Está localizado no 6° andar da Escola Politécnica, tendo nas suas instalações o LABGEO - Laboratório de Geomensura Theodoro Sampaio, o CETRAMA - Centro de Estudos de Transporte e Maio Ambiente, voltado à pesquisa, e um acervo de equipamentos utilizados para levantamentos topográficos. Atualmente oferta disciplinas para os cursos de Graduação em Engenharia e Tecnologia em Transportes Terrestre.'|t }}</p>
        <p>{{ 'Este departamento, originalmente denominado de Departamento 045 e depois Departamento de Transportes - DT, desempenhou um papel de suma importância, notadamente, no que tange ao ensino, pesquisa e extensão na área de infraestrutura e planejamento de transportes nesta Universidade.'|t }}</p>
      </div>
    </section>

    {# CORPO DOCENTE #}
    <section id="docentes" class="detg-section">
      <div class="section-title-container">
        <h2 class="section-title">{{ 'Corpo Docente'|t }}</h2>
        <div class="section-line"></div>
        <a href="/docentes" class="section-link">{{ 'Ver todos os docentes'|t }}</a>
      </div>
      <div class="docentes-grid">
        <div class="docente-card">
          <div class="docente-avatar">AB</div>
          <div><h4 class="docente-name">Artur Caldas Brandão</h4><p class="docente-role">{{ 'Chefe do DETG'|t }}</p></div>
        </div>
        <div class="docente-card">
          <div class="docente-avatar">JD</div>
          <div><h4 class="docente-name">Juan Pedro Moreno Delgado</h4><p class="docente-role">{{ 'Vice-Chefe do DETG'|t }}</p></div>
        </div>
        <div class="docente-card">
          <div class="docente-avatar">EF</div>
          <div><h4 class="docente-name">Élio Santana Fontes</h4><p class="docente-role">{{ 'Decano do DETG'|t }}</p></div>
        </div>
      </div>
    </section>

    {# PRODUÇÃO ACADÊMICA #}
    <section id="producao" class="detg-section">
      <div class="section-title-container">
        <h2 class="section-title">{{ 'Produção Acadêmica'|t }}</h2>
        <div class="section-line"></div>
      </div>
      <div class="producao-grid">
        <div class="producao-stat"><span class="producao-number">200+</span><span class="producao-label">{{ 'Artigos'|t }}</span></div>
        <div class="producao-stat"><span class="producao-number">45+</span><span class="producao-label">{{ 'Dissertações'|t }}</span></div>
        <div class="producao-stat"><span class="producao-number">12+</span><span class="producao-label">{{ 'Projetos'|t }}</span></div>
      </div>
    </section>

    {# LABORATÓRIOS #}
    <section id="laboratorios" class="detg-section">
      <div class="section-title-container">
        <h2 class="section-title">{{ 'Laboratórios'|t }}</h2>
        <div class="section-line"></div>
      </div>
      <div class="labs-grid">
        <div class="lab-card">
          <div class="lab-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg></div>
          <h3 class="lab-name">LABGEO</h3><p class="lab-desc">{{ 'Laboratório de Geomensura Theodoro Sampaio'|t }}</p>
        </div>
        <div class="lab-card">
          <div class="lab-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/></svg></div>
          <h3 class="lab-name">LTGEO</h3><p class="lab-desc">{{ 'Laboratório de Topografia e Geodésia'|t }}</p>
        </div>
        <div class="lab-card">
          <div class="lab-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg></div>
          <h3 class="lab-name">LABTRANS</h3><p class="lab-desc">{{ 'Laboratório de Transportes'|t }}</p>
        </div>
        <div class="lab-card">
          <div class="lab-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg></div>
          <h3 class="lab-name">CETRAMA</h3><p class="lab-desc">{{ 'Centro de Estudos de Transporte e Meio Ambiente'|t }}</p>
        </div>
        <div class="lab-card">
          <div class="lab-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg></div>
          <h3 class="lab-name">LABGPS</h3><p class="lab-desc">{{ 'Laboratório de GPS e Sensoriamento Remoto'|t }}</p>
        </div>
      </div>
    </section>

    {# NOTÍCIAS #}
    <section id="noticias" class="detg-section">
      <div class="section-title-container">
        <h2 class="section-title">{{ 'Notícias'|t }}</h2>
        <div class="section-line"></div>
        <a href="/noticias" class="section-link">{{ 'Ver todas as notícias'|t }}</a>
      </div>
      <div class="noticias-grid">
        <article class="noticia-card">
          <div class="noticia-img-placeholder" aria-hidden="true">
            <svg width="40" height="40" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>
          </div>
          <div class="noticia-body">
            <span class="noticia-tag">{{ 'Pesquisa'|t }}</span>
            <h3 class="noticia-title"><a href="#">{{ 'DETG apresenta resultados de pesquisa em mobilidade urbana em congresso nacional'|t }}</a></h3>
            <span class="noticia-date">{{ 'Março, 2025'|t }}</span>
          </div>
        </article>
        <article class="noticia-card">
          <div class="noticia-img-placeholder" aria-hidden="true">
            <svg width="40" height="40" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
          </div>
          <div class="noticia-body">
            <span class="noticia-tag">{{ 'Evento'|t }}</span>
            <h3 class="noticia-title"><a href="#">{{ 'Semana de Engenharia 2025 terá palestras do DETG sobre infraestrutura viária'|t }}</a></h3>
            <span class="noticia-date">{{ 'Fevereiro, 2025'|t }}</span>
          </div>
        </article>
      </div>
    </section>

  </main>

  {# ── COL 3: LATERAL DIREITA ──────────────────────────── #}
  <aside id="sidebar-second" role="complementary" aria-label="{{ 'Agenda e avisos'|t }}">

    {# AVISOS IMPORTANTES — amarelo #}
    <div class="detg-widget widget-avisos">
      <div class="widget-avisos-header">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
        </svg>
        <span>{{ 'Avisos Importantes'|t }}</span>
      </div>
      <div class="widget-avisos-body">
        <div class="aviso-item aviso-destaque">
          <span class="aviso-titulo">{{ 'Novo período de Rematrícula'|t }}</span>
          <span class="aviso-texto">{{ 'De 23/03 a 26/03/2026: Rematrícula'|t }}</span>
        </div>
        <div class="aviso-item">
          <span class="aviso-titulo">{{ 'Prazo de defesa TCC'|t }}</span>
          <span class="aviso-texto">{{ 'Submissão até 30/04/2026'|t }}</span>
        </div>
        <div class="aviso-item">
          <span class="aviso-titulo">{{ 'Reunião de Departamento'|t }}</span>
          <span class="aviso-texto">{{ '05/05/2026 — Sala 601, 14h'|t }}</span>
        </div>
        <div class="aviso-item">
          <span class="aviso-titulo">{{ 'Seleção Pós-Graduação'|t }}</span>
          <span class="aviso-texto">{{ 'Inscrições até 15/05/2026'|t }}</span>
        </div>
        <a href="/avisos" class="aviso-ver-todos">{{ 'Ver todos os avisos →'|t }}</a>
      </div>
    </div>

    {# AGENDA GOOGLE CALENDAR #}
    <div class="detg-widget">
      <h3 class="detg-widget-title">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
        {{ 'Agenda do DETG'|t }}
      </h3>
      <div class="agenda-embed">
        <iframe
          src="https://calendar.google.com/calendar/embed?src=pt-br.brazilian%23holiday%40group.v.calendar.google.com&ctz=America%2FBahia&showTitle=0&showNav=1&showDate=1&showPrint=0&showTabs=0&showCalendars=0&showTz=0&mode=AGENDA&height=280"
          width="100%" height="280" frameborder="0" scrolling="no"
          title="{{ 'Agenda do DETG'|t }}" loading="lazy">
        </iframe>
      </div>
      <a href="https://calendar.google.com" target="_blank" rel="noopener" class="agenda-link">
        {{ 'Ver no Google Calendar →'|t }}
      </a>
    </div>

    {# MAPA #}
    <div class="detg-widget">
      <h3 class="detg-widget-title">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" style="width:1rem;height:1rem">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
        {{ 'Onde Estamos'|t }}
      </h3>
      <div class="sidebar-map">
        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3887.8!2d-38.5158!3d-12.9999!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x716047a5f30bfff%3A0xb32d25d076e01d3!2sEscola+Polit%C3%A9cnica+-+UFBA!5e0!3m2!1spt-BR!2sbr!4v1"
          title="{{ 'Escola Politécnica da UFBA'|t }}" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen>
        </iframe>
      </div>
      <div class="contato-item">
        <div class="contato-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/></svg></div>
