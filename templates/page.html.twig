{#
/**
 * @file
 * DETG theme implementation to display a single Drupal page.
 */
#}

{# ============================================================ #}
{# BARRA DO GOVERNO FEDERAL (oficial) #}
{# ============================================================ #}
<div id="barra-brasil" style="background:#7f7f7f; height:20px; padding:0 0 0 10px; display:block; width:100%; z-index:9999;"></div>
<script src="https://barra.brasil.gov.br/barra_2.0.js" type="text/javascript"></script>

{# ============================================================ #}
{# CHROME: marca + menu + busca (acompanha o scroll) #}
{# ============================================================ #}
<div class="site-sticky-sentinel" aria-hidden="true"></div>
<header id="main-header" class="site-chrome" role="banner">
  <div class="site-chrome__inner">

    <a class="site-brand" href="{{ path('<front>') }}" aria-label="{{ 'DETG — Departamento de Engenharia de Transportes e Geodésia'|t }}">
      <span class="site-brand__mark" aria-hidden="true">
        <img src="{{ detg_logo }}" alt="" width="52" height="52">
      </span>
      <span class="site-brand__text">
        <span class="site-brand__name">DETG</span>
        <span class="site-brand__desc">{{ 'Departamento de Engenharia de'|t }}<br>{{ 'Transportes e Geodésia'|t }}</span>
        <span class="site-brand__org">{{ 'Universidade Federal da Bahia'|t }}</span>
      </span>
    </a>

    {% if page.header %}
      <div class="site-chrome__header-region">
        {{ page.header }}
      </div>
    {% endif %}

    <button
      id="mobile-menu-btn"
      class="site-chrome__toggle"
      type="button"
      aria-controls="mobile-menu-content"
      aria-expanded="false"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
      <span class="visually-hidden">{{ 'Abrir menu'|t }}</span>
    </button>

    <div id="mobile-menu-content" class="site-chrome__nav" role="navigation">
      <nav id="main-nav" aria-label="{{ 'Main navigation'|t }}">
        <ul class="nav-links">
          {% for item in detg_nav %}
            <li class="nav-menu-item{% if item.active %} nav-menu-item--active-trail{% endif %}">
              <a href="{{ item.url }}" class="nav-item{% if item.active %} is-active{% endif %}">{{ item.title }}</a>
            </li>
          {% endfor %}
        </ul>
      </nav>

      <div class="nav-search">
        <div class="nav-search-inner">
          <input type="text" id="search_menu" placeholder="{{ 'Buscar no DETG...'|t }}" aria-label="{{ 'Buscar no site'|t }}"/>
          <span class="nav-search-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
          </span>
        </div>
      </div>
    </div>

  </div>
</header>

{# ============================================================ #}
{# HERO — somente na página inicial #}
{# ============================================================ #}
{% if is_front %}
  <section class="hero" aria-label="{{ 'Apresentação do DETG'|t }}">
    <div class="hero__inner">
      <div class="hero__copy">
        <h1 class="hero__title">
          {{ 'Departamento de Engenharia de'|t }}
          <span class="hero__accent hero__accent--blue">{{ 'Transportes'|t }}</span>
          {{ 'e'|t }}
          <span class="hero__accent hero__accent--orange">{{ 'Geodésia'|t }}</span>
        </h1>
        <p class="hero__lead">
          {{ 'Formação, pesquisa e inovação para sistemas de transporte eficientes, cidades inteligentes e territórios bem planejados.'|t }}
        </p>
        <div class="hero__actions">
          <a href="/institucional" class="btn btn--primary">{{ 'Conheça o DETG'|t }} →</a>
          <a href="/laboratorios" class="btn btn--ghost">{{ 'Laboratórios'|t }}</a>
        </div>
      </div>
    </div>
  </section>
{% endif %}

{# ============================================================ #}
{# MAIN CONTENT
   - Home e demais páginas: grade de 3 colunas
   - Página de docente: layout full-width (sem sidebars da home)
#}
{# ============================================================ #}
{% if is_docente_page %}
  <div class="main-grid main-grid--docente" id="main-content">
    <main class="main-content main-content--docente" id="content" role="main">
      {{ page.content }}
    </main>
  </div>
{% elseif is_info_page %}
  <div class="main-grid main-grid--wide" id="main-content">
    <main class="main-content main-content--wide" id="content" role="main">
      {{ page.content }}
    </main>
  </div>
{% else %}
  <div class="main-grid" id="main-content">

    {# --- COLUNA ESQUERDA (Sistemas / Secretaria) --- #}
    <aside class="sidebar-left" aria-label="{{ 'Sistemas e Secretaria'|t }}">
      {% if page.sidebar_first %}
        {{ page.sidebar_first }}
      {% else %}
        <div class="widget-card">
          <h3 class="widget-title">
            <span class="widget-title__icon widget-title__icon--blue" aria-hidden="true">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
              </svg>
            </span>
            {{ 'Sistemas'|t }}
          </h3>
          <div>
            <a href="https://ava.ufba.br/" class="sistema-link">
              <span class="sistema-icon sistema-icon--moodle" aria-hidden="true">M</span>
              <span class="sistema-link-text">
                <span class="sistema-link-name">Moodle</span>
                <span class="sistema-link-desc">{{ 'Ambiente Virtual de Aprendizagem'|t }}</span>
              </span>
            </a>
            <a href="https://sigaa.ufba.br/sigaa/public/home.jsf" class="sistema-link">
              <span class="sistema-icon sistema-icon--sigaa" aria-hidden="true">S</span>
              <span class="sistema-link-text">
                <span class="sistema-link-name">SIGAA</span>
                <span class="sistema-link-desc">{{ 'Sistema Integrado de Gestão Acadêmica'|t }}</span>
              </span>
            </a>
            <a href="#" class="sistema-link">
              <span class="sistema-icon sistema-icon--reserva" aria-hidden="true">R</span>
              <span class="sistema-link-text">
                <span class="sistema-link-name">{{ 'Reserva de Equipamentos'|t }}</span>
                <span class="sistema-link-desc">{{ 'Agendamento de equipamentos e laboratórios'|t }}</span>
              </span>
            </a>
          </div>
        </div>

        <div class="widget-card">
          <h3 class="widget-title">
            <span class="widget-title__icon widget-title__icon--emerald" aria-hidden="true">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
              </svg>
            </span>
            {{ 'Secretaria'|t }}
          </h3>
          <p class="secretaria-lead">{{ 'Atendimento presencial e remoto'|t }}</p>
          <ul class="secretaria-list">
            <li><a href="#"><span class="secretaria-dot"></span>{{ 'Documentos'|t }}</a></li>
            <li><a href="https://ufba.br/legislacao"><span class="secretaria-dot"></span>{{ 'Legislação'|t }}</a></li>
            <li><a href="#"><span class="secretaria-dot"></span>{{ 'Formulários'|t }}</a></li>
          </ul>
        </div>
      {% endif %}
    </aside>

    {# --- CONTEÚDO CENTRAL --- #}
    <main class="main-content" id="content" role="main">
      {% if not is_front and detg_breadcrumb %}
        <nav class="page-breadcrumb" aria-label="{{ 'Breadcrumb'|t }}">
          {{ detg_breadcrumb }}
        </nav>
      {% endif %}
      {{ page.content }}
    </main>

    {# --- COLUNA DIREITA (Calendário / Avisos) --- #}
    <aside class="sidebar-right" aria-label="{{ 'Calendário e Avisos'|t }}">
      <div class="calendar-widget agenda-widget">
        <div class="agenda-widget__header">
          <h3 class="agenda-widget__title">{{ 'Agenda do DETG'|t }}</h3>
          <a
            class="agenda-widget__all"
            href="https://calendar.google.com/calendar/u/0/r?cid=detg.ufba%40gmail.com"
            target="_blank"
            rel="noopener noreferrer">{{ 'Ver todas'|t }}</a>
        </div>
        {% if detg_agenda %}
          <ul class="agenda-list">
            {% for event in detg_agenda %}
              <li class="agenda-item">
                <div class="agenda-item__date">
                  <div class="agenda-item__day">{{ event.day }}</div>
                  <div class="agenda-item__month">{{ event.month }}</div>
                </div>
                <div class="agenda-item__body">
                  <div class="agenda-item__title">{{ event.title }}</div>
                  {% if event.meta %}
                    <div class="agenda-item__meta">{{ event.meta }}</div>
                  {% endif %}
                </div>
              </li>
            {% endfor %}
          </ul>
        {% else %}
          <p class="agenda-empty">{{ 'Nenhum evento agendado no momento.'|t }}</p>
        {% endif %}
      </div>

      {% if page.sidebar_second %}
        {{ page.sidebar_second }}
      {% else %}
        <div class="avisos-widget">
          <h4 class="avisos-title">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M10.29 3.86 1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
            </svg>
            {{ 'Avisos Importantes'|t }}
          </h4>
          <p class="avisos-empty">{{ 'Cadastre avisos no tipo de conteúdo Aviso para exibi-los aqui.'|t }}</p>
        </div>
      {% endif %}
    </aside>

  </div>{# end .main-grid #}

  {# ============================================================ #}
  {# SEÇÃO NOTÍCIAS #}
  {# ============================================================ #}
  {% if page.news %}
    <section id="noticias" class="news-section" aria-label="{{ 'Últimas Notícias'|t }}">
      {{ page.news }}
    </section>
  {% endif %}
{% endif %}

{# ============================================================ #}
{# FOOTER #}
{# ============================================================ #}
<footer class="site-footer" role="contentinfo">
  <div class="footer-grid">

    <div class="footer-brand-col">
      {% if page.footer_col1 %}
        {{ page.footer_col1 }}
      {% else %}
        <div class="site-brand site-brand--footer">
          <span class="site-brand__mark" aria-hidden="true">
            <img src="{{ detg_logo }}" alt="" width="56" height="56">
          </span>
          <span class="site-brand__text">
            <span class="site-brand__name">DETG</span>
            <span class="site-brand__desc">{{ 'Departamento de Engenharia de Transportes e Geodésia'|t }}</span>
          </span>
        </div>
        <p class="footer-about-text">
          {{ 'Ciência, tecnologia e inovação a serviço da sociedade e do território.'|t }}
        </p>
        <div class="footer-social">
          <a href="https://github.com/leandrosferreiro/siteDETG-Drupal10"
             target="_blank"
             rel="noopener noreferrer"
             aria-label="{{ 'GitHub do projeto DETG'|t }}">
            <svg fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.207 11.387.6.11.793-.26.793-.577 0-.285-.01-1.04-.016-2.04-3.338.726-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.757-1.333-1.757-1.09-.745.083-.73.083-.73 1.205.085 1.84 1.237 1.84 1.237 1.07 1.834 2.807 1.304 3.492.997.108-.775.418-1.305.762-1.605-2.665-.303-5.467-1.333-5.467-5.93 0-1.31.468-2.382 1.236-3.222-.124-.303-.536-1.523.117-3.176 0 0 1.008-.322 3.3 1.23a11.5 11.5 0 0 1 3.003-.404c1.02.005 2.047.138 3.003.404 2.29-1.552 3.297-1.23 3.297-1.23.655 1.653.243 2.873.12 3.176.77.84 1.235 1.912 1.235 3.222 0 4.61-2.807 5.624-5.48 5.921.43.372.823 1.102.823 2.222 0 1.606-.015 2.902-.015 3.297 0 .32.192.694.8.576C20.565 21.796 24 17.297 24 12 24 5.37 18.63 0 12 0z"/>
            </svg>
          </a>
        </div>
      {% endif %}
    </div>

    <div>
      {% if page.footer_col2 %}
        {{ page.footer_col2 }}
      {% else %}
        <h4 class="footer-col-title">{{ 'Acesso Rápido'|t }}</h4>
        <ul class="footer-links">
          <li><a href="/docentes">{{ 'Docentes'|t }}</a></li>
          <li><a href="/disciplinas">{{ 'Disciplinas'|t }}</a></li>
          <li><a href="/laboratorios">{{ 'Laboratórios'|t }}</a></li>
        </ul>
      {% endif %}
    </div>

    <div>
      {% if page.footer_col3 %}
        {{ page.footer_col3 }}
      {% else %}
        <h4 class="footer-col-title">{{ 'Contato'|t }}</h4>
        <ul class="footer-contact-list">
          <li class="footer-contact-item">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <span>detg@ufba.br</span>
          </li>
          <li class="footer-contact-item">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <span>71 3283-9821</span>
          </li>
        </ul>
      {% endif %}
    </div>

    <div>
      {% if page.footer_col4 %}
        {{ page.footer_col4 }}
      {% else %}
        <h4 class="footer-col-title">{{ 'Endereço'|t }}</h4>
        <p class="footer-address">
          {{ 'Escola Politécnica – UFBA'|t }}<br>
          {{ 'Rua Aristides Novis, 2 – 6º andar'|t }}<br>
          {{ 'Federação, Salvador – BA'|t }}<br>
          CEP: 40210-630
        </p>
      {% endif %}
    </div>

  </div>

  <div class="footer-bottom">
    <p class="footer-copy">&copy; {{ "now"|date("Y") }} {{ 'Universidade Federal da Bahia. Todos os direitos reservados.'|t }}</p>
  </div>
</footer>
