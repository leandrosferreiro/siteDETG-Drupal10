{#
/**
 * @file
 * DETG theme implementation to display a single Drupal page.
 */
#}

{# ============================================================ #}
{# BARRA DO GOVERNO FEDERAL #}
{# ============================================================ #}
<div id="barra-brasil" style="background:#7f7f7f; height:20px; padding:0 0 0 10px; display:block; width:100%; z-index:9999;"></div>
<script src="https://barra.brasil.gov.br/barra_2.0.js" type="text/javascript"></script>

{# ============================================================ #}
{# HEADER / TOPO — alinhado à DIREITA no desktop, centralizado no mobile #}
{# ============================================================ #}
<header id="main-header" role="banner">
  <div class="header-inner container-wide">
    <div class="site-name-wrapper">
      {% if page.header %}
        {{ page.header }}
      {% else %}
        <h1 class="site-name">
          Departamento de Engenharia de<br>
          <span class="gradient-text">Transportes</span>
          <span class="connector-text"> e </span>
          <span class="earth-text">Geodésia</span>
        </h1>
        <p class="site-slogan">Universidade Federal da Bahia - Escola Politécnica</p>
      {% endif %}
    </div>
  </div>
</header>

{# ============================================================ #}
{# MENU PRINCIPAL #}
{# ============================================================ #}
<nav id="main-nav" aria-label="{{ 'Main navigation'|t }}">
  <div class="nav-wrapper">

    {# Botão hambúrguer — visível só no mobile #}
    <div class="nav-mobile-header">
      <span class="nav-mobile-label">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"/>
        </svg>
        {{ 'MENU'|t }}
      </span>
      <button id="mobile-menu-btn" aria-controls="mobile-menu-content" aria-expanded="false">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <span class="visually-hidden">{{ 'Toggle menu'|t }}</span>
      </button>
    </div>

    {# Conteúdo do menu (links + busca) #}
    <div id="mobile-menu-content" role="navigation">

      {% if page.primary_menu %}
        {{ page.primary_menu }}
      {% else %}
        {# Fallback: menu estático #}
        <ul class="nav-links">
          <li>
            <a href="{{ path('<front>') }}" class="nav-item" title="{{ 'Início'|t }}">
                            <svg class="w-6 h-6 text-white hover:text-blue-200 transition-transform hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 21l4-9 4 9" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 12h4" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.5 12V7.5a1.5 1.5 0 013 0V12" />
                                <circle cx="12" cy="7.5" r="2.2" stroke-width="1.5" fill="rgba(255,255,255,0.1)" />
                                <circle cx="12" cy="7.5" r="0.5" fill="currentColor" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 4h4" />
                            </svg>
            </a>
          </li>
          <li><a href="/institucional" class="nav-item">{{ 'Institucional'|t }}</a></li>
          <li><a href="/docentes" class="nav-item">{{ 'Docentes'|t }}</a></li>
          <li><a href="/laboratorios" class="nav-item">{{ 'Laboratórios'|t }}</a></li>
          <li><a href="/noticias" class="nav-item">{{ 'Notícias'|t }}</a></li>
        </ul>
      {% endif %}

      {# Barra de busca — SEMPRE presente, absoluta à direita no desktop #}
      <div class="nav-search">
        <div class="nav-search-inner">
          <div class="nav-search-icon">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
          </div>
          <input type="text" id="search_menu" placeholder="{{ 'BUSCAR...'|t }}" aria-label="{{ 'Buscar no site'|t }}"/>
        </div>
      </div>

    </div>{# end #mobile-menu-content #}
  </div>
</nav>

{# ============================================================ #}
{# MAIN CONTENT
   - Home e demais páginas: grade de 3 colunas
   - Página de docente: layout full-width (sem sidebars da home)
#}
{# ============================================================ #}
{% if is_docente_page %}
  <div class="main-grid main-grid--docente" id="main-content">
    <main class="main-content main-content--docente" id="content" role="main">
      {{ page.content }}
    </main>
  </div>
{% else %}
  <div class="main-grid" id="main-content">

    {# --- COLUNA ESQUERDA (Sistemas / Secretaria) --- #}
    <aside class="sidebar-left" aria-label="{{ 'Sistemas e Secretaria'|t }}">
      {% if page.sidebar_first %}
        {{ page.sidebar_first }}
      {% else %}
        <div class="widget-card">
          <h3 class="widget-title">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
            </svg>
            {{ 'Sistemas'|t }}
          </h3>
          <div>
            <a href="https://sigaa.ufba.br/sigaa/public/home.jsf" class="sistema-link">
              <span class="sistema-link-name">SIGAA</span>
              <span class="sistema-link-desc">{{ 'Sistema Acadêmico'|t }}</span>
            </a>
            <a href="https://ava.ufba.br/" class="sistema-link">
              <span class="sistema-link-name">Moodle</span>
              <span class="sistema-link-desc">{{ 'Ambiente Virtual'|t }}</span>
            </a>
            <a href="#" class="sistema-link" style="border-top:1px solid #f9fafb;margin-top:.25rem;padding-top:.5rem;">
              {{ 'Reserva de Equipamentos'|t }}
            </a>
            <a href="https://eng.ufba.br/reserva-de-laboratorio" class="sistema-link">{{ 'Reserva de Laboratórios'|t }}</a>
          </div>
        </div>

        <div class="widget-card">
          <h3 class="widget-title">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color:#6b7280">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            {{ 'Secretaria'|t }}
          </h3>
          <ul class="secretaria-list">
            <li><a href="#"><span class="secretaria-dot"></span>{{ 'Documentos'|t }}</a></li>
            <li><a href="https://ufba.br/legislacao"><span class="secretaria-dot"></span>{{ 'Legislação'|t }}</a></li>
            <li><a href="#"><span class="secretaria-dot"></span>{{ 'Formulários'|t }}</a></li>
          </ul>
        </div>
      {% endif %}
    </aside>

    {# --- CONTEÚDO CENTRAL --- #}
    <main class="main-content" id="content" role="main">
      {{ page.content }}
    </main>

    {# --- COLUNA DIREITA (Calendário / Avisos) --- #}
    <aside class="sidebar-right" aria-label="{{ 'Calendário e Avisos'|t }}">
      {% if page.sidebar_second %}
        {{ page.sidebar_second }}
      {% else %}
        <div class="calendar-widget">
          <h3 class="widget-title">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            {{ 'Agenda do DETG'|t }}
          </h3>
          <div class="calendar-iframe-wrapper">
            {# Agenda oficial DETG — detg.ufba@gmail.com #}
            <iframe
              src="https://calendar.google.com/calendar/embed?src=detg.ufba%40gmail.com&ctz=America%2FFortaleza"
              title="{{ 'Agenda DETG UFBA'|t }}"
              loading="lazy"
              style="border:0">
            </iframe>
          </div>
          <a
            class="calendar-open-link"
            href="https://calendar.google.com/calendar/u/0/r?cid=detg.ufba%40gmail.com"
            target="_blank"
            rel="noopener noreferrer">
            {{ 'Abrir agenda no Google Calendar'|t }}
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>
        </div>

        {# Fallback só se a view/bloco de avisos não estiver na região #}
        <div class="avisos-widget">
          <h4 class="avisos-title">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"/>
            </svg>
            {{ 'Avisos Importantes'|t }}
          </h4>
          <p class="avisos-empty">{{ 'Cadastre avisos no tipo de conteúdo Aviso para exibi-los aqui.'|t }}</p>
        </div>
      {% endif %}
    </aside>

  </div>{# end .main-grid #}

  {# ============================================================ #}
  {# SEÇÃO NOTÍCIAS #}
  {# ============================================================ #}
  {% if page.news %}
    <section id="noticias" class="news-section" aria-label="{{ 'Últimas Notícias'|t }}">
      {{ page.news }}
    </section>
  {% endif %}
{% endif %}

{# ============================================================ #}
{# FOOTER #}
{# ============================================================ #}
<footer class="site-footer" role="contentinfo">
  <div class="footer-grid">

    <div>
      {% if page.footer_col1 %}
        {{ page.footer_col1 }}
      {% else %}
        <h4 class="footer-col-title">DETG / UFBA</h4>
        <p class="footer-about-text">
          {{ 'Departamento de Engenharia de Transportes e Geodésia da Escola Politécnica da UFBA.'|t }}
        </p>
        <div class="footer-social">
          <a href="https://github.com/leandrosferreiro/siteDETG-Drupal10"
             target="_blank"
             rel="noopener noreferrer"
             aria-label="{{ 'GitHub do projeto DETG'|t }}">
            <svg fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.207 11.387.6.11.793-.26.793-.577 0-.285-.01-1.04-.016-2.04-3.338.726-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.757-1.333-1.757-1.09-.745.083-.73.083-.73 1.205.085 1.84 1.237 1.84 1.237 1.07 1.834 2.807 1.304 3.492.997.108-.775.418-1.305.762-1.605-2.665-.303-5.467-1.333-5.467-5.93 0-1.31.468-2.382 1.236-3.222-.124-.303-.536-1.523.117-3.176 0 0 1.008-.322 3.3 1.23a11.5 11.5 0 0 1 3.003-.404c1.02.005 2.047.138 3.003.404 2.29-1.552 3.297-1.23 3.297-1.23.655 1.653.243 2.873.12 3.176.77.84 1.235 1.912 1.235 3.222 0 4.61-2.807 5.624-5.48 5.921.43.372.823 1.102.823 2.222 0 1.606-.015 2.902-.015 3.297 0 .32.192.694.8.576C20.565 21.796 24 17.297 24 12 24 5.37 18.63 0 12 0z"/>
            </svg>
          </a>
        </div>
      {% endif %}
    </div>

    <div>
      {% if page.footer_col2 %}
        {{ page.footer_col2 }}
      {% else %}
        <h4 class="footer-col-title">{{ 'Acesso Rápido'|t }}</h4>
        <ul class="footer-links">
          <li><a href="#">{{ 'Portal UFBA'|t }}</a></li>
          <li><a href="#">{{ 'Escola Politécnica'|t }}</a></li>
          <li><a href="#">{{ 'Processos Seletivos'|t }}</a></li>
        </ul>
      {% endif %}
    </div>

    <div>
      {% if page.footer_col3 %}
        {{ page.footer_col3 }}
      {% else %}
        <h4 class="footer-col-title">{{ 'Contato'|t }}</h4>
        <ul class="footer-contact-list">
          <li class="footer-contact-item">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <span>detg@ufba.br</span>
          </li>
          <li class="footer-contact-item">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <span>(71) 3283-9821</span>
          </li>
        </ul>
      {% endif %}
    </div>

    <div>
      {% if page.footer_col4 %}
        {{ page.footer_col4 }}
      {% else %}
        <h4 class="footer-col-title">{{ 'Endereço'|t }}</h4>
        <p class="footer-address">
          {{ 'Rua Prof. Aristides Novis, 2'|t }}<br>
          {{ 'Federação'|t }}<br>
          {{ 'Salvador - BA'|t }}<br>
          CEP: 40210-630
        </p>
      {% endif %}
    </div>

  </div>

  <div class="footer-bottom">
    <p class="footer-copy">&copy; {{ "now"|date("Y") }} DETG.</p>
  </div>
</footer>
