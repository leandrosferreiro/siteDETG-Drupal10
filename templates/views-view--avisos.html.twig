{#
/**
 * @file
 * View Avisos — quadro âmbar "Avisos Importantes".
 */
#}
{%
  set classes = [
    'view',
    'detg-view',
    'view-avisos',
    'view-id-' ~ id,
    'view-display-id-' ~ display_id,
    'avisos-widget',
    dom_id ? 'js-view-dom-id-' ~ dom_id,
  ]
%}
<div{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  <h4 class="avisos-title">
    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M10.29 3.86 1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
    </svg>
    {{ title|default('Avisos Importantes'|t) }}
  </h4>
  {{ title_suffix }}

  {% if header %}
    <div class="view-header">{{ header }}</div>
  {% endif %}

  {% if rows %}
    {{ rows }}
  {% elseif empty %}
    <div class="avisos-empty">
      {{ empty }}
      <p>{{ 'Nenhum aviso publicado no momento.'|t }}</p>
    </div>
  {% endif %}

  {% if pager %}
    <div class="detg-view__pager">{{ pager }}</div>
  {% endif %}

  {% if more %}
    {{ more }}
  {% endif %}
</div>
