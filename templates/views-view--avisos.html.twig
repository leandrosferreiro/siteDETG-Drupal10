{#
/**
 * @file
 * View Avisos — quadro amarelo "Avisos Importantes".
 */
#}
{%
  set classes = [
    'view',
    'detg-view',
    'view-avisos',
    'view-id-' ~ id,
    'view-display-id-' ~ display_id,
    'avisos-widget',
    dom_id ? 'js-view-dom-id-' ~ dom_id,
  ]
%}
<div{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  <h4 class="avisos-title">
    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"/>
    </svg>
    {{ title|default('Avisos Importantes'|t) }}
  </h4>
  {{ title_suffix }}

  {% if header %}
    <div class="view-header">{{ header }}</div>
  {% endif %}

  {% if rows %}
    {{ rows }}
  {% elseif empty %}
    <div class="avisos-empty">
      {{ empty }}
      <p>{{ 'Nenhum aviso publicado no momento.'|t }}</p>
    </div>
  {% endif %}

  {% if pager %}
    <div class="detg-view__pager">{{ pager }}</div>
  {% endif %}

  {% if more %}
    {{ more }}
  {% endif %}
</div>
