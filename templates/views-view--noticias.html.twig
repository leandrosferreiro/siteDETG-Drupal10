{#
/**
 * @file
 * View Notícias — grade de cards (home na região news; página /noticias).
 */
#}
{%
  set classes = [
    'view',
    'detg-view',
    'view-noticias',
    'view-id-' ~ id,
    'view-display-id-' ~ display_id,
    dom_id ? 'js-view-dom-id-' ~ dom_id,
  ]
%}
{% set is_block = display_id starts with 'block' %}
<div{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {% if is_block %}
    <div class="section-heading news-header">
      <h2 class="section-heading__title">
        <span class="section-heading__bar" aria-hidden="true"></span>
        {{ title|default('Últimas Notícias'|t) }}
      </h2>
      <a href="{{ path('view.noticias.page_1') }}" class="section-heading__more">
        {{ 'Ver todas'|t }} →
      </a>
    </div>
  {% else %}
    <div class="page-intro">
      <h1 class="page-intro__title">{{ title|default('Notícias'|t) }}</h1>
      <p class="page-intro__lead">{{ 'Acompanhe as últimas notícias do DETG.'|t }}</p>
    </div>
  {% endif %}
  {{ title_suffix }}

  {% if header %}
    <div class="view-header">{{ header }}</div>
  {% endif %}

  {% if exposed %}
    <div class="view-filters">{{ exposed }}</div>
  {% endif %}

  {% if rows %}
    <div class="news-grid detg-view__rows">{{ rows }}</div>
  {% elseif empty %}
    <div class="detg-view__empty">
      {{ empty }}
      <p>{{ 'Nenhuma notícia publicada ainda.'|t }}</p>
    </div>
  {% endif %}

  {% if pager %}
    <div class="detg-view__pager">{{ pager }}</div>
  {% endif %}

  {% if more %}
    {{ more }}
  {% endif %}
</div>
