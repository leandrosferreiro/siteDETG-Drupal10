{#
/**
 * @file
 * Menu Secretaria — lista com bullets (coluna esquerda).
 */
#}
{% import _self as menus %}
{{ menus.menu_links(items, attributes, 0) }}

{% macro menu_links(items, attributes, menu_level) %}
  {% import _self as menus %}
  {% if items %}
    <ul{{ attributes.addClass('secretaria-list') }}>
      {% for item in items %}
        {% set url_str = item.url.toString %}
        {% set is_external = item.url.isExternal %}
        {%
          set item_classes = [
            'secretaria-list__item',
            item.in_active_trail ? 'is-active',
          ]
        %}
        <li{{ item.attributes.addClass(item_classes) }}>
          <a
            href="{{ url_str }}"
            class="secretaria-link{% if item.in_active_trail %} is-active{% endif %}"
            {% if is_external %} target="_blank" rel="noopener noreferrer"{% endif %}
          >
            <span class="secretaria-dot" aria-hidden="true"></span>
            <span class="secretaria-link-text">{{ item.title }}</span>
          </a>
          {% if item.below %}
            {{ menus.menu_links(item.below, attributes.removeClass('secretaria-list'), menu_level + 1) }}
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  {% endif %}
{% endmacro %}
