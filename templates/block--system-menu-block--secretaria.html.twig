{#
/**
 * @file
 * Bloco do menu Secretaria — card da coluna esquerda.
 */
#}
{%
  set classes = [
    'block',
    'block-menu',
    'widget-card',
    'widget-card--secretaria',
    'navigation',
    'menu--secretaria',
  ]
%}
<nav{{ attributes.addClass(classes) }} aria-label="{{ 'Secretaria'|t }}">
  {% if label %}
    <h3{{ title_attributes.addClass('widget-title') }}>
      <span class="widget-title__icon widget-title__icon--emerald" aria-hidden="true">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
      </span>
      {{ label }}
    </h3>
  {% endif %}
  {% block content %}
    {{ content }}
  {% endblock %}
</nav>
