/**
 * @file
 * Bloco do menu principal sem wrapper extra.
 #}
<nav{{ attributes.addClass('block', 'block-menu', 'navigation', 'menu--main') }}>
  {{ title_prefix }}
  {% if label and configuration.label_display %}
    <h2{{ title_attributes }} class="visually-hidden">{{ label }}</h2>
  {% endif %}
  {{ title_suffix }}
  {% block content %}
    {{ content }}
  {% endblock %}
</nav>
