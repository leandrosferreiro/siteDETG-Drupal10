{#
/**
 * @file
 * Teaser de Laboratório — card com ícone ou miniatura.
 */
#}
<article{{ attributes.addClass('lab-card-wrap') }}>
  <a href="{{ url }}" class="lab-card" rel="bookmark">
    {% if detg.has_image %}
      <div class="lab-icon lab-icon--photo" aria-hidden="true">
        {{ content.field_imagem }}
      </div>
    {% else %}
      <div class="lab-icon" aria-hidden="true">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.384-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/>
        </svg>
      </div>
    {% endif %}
    <h3 class="lab-name">{{ detg.sigla ?: detg.name }}</h3>
    {% if detg.sigla %}
      <p class="lab-desc">{{ detg.name }}</p>
    {% elseif detg.coord %}
      <p class="lab-desc">Coord.: {{ detg.coord }}</p>
    {% endif %}
  </a>
</article>
