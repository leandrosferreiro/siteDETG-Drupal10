{#
/**
 * @file
 * Teaser de Laboratório — card com imagem no topo (html_DETG).
 */
#}
<article{{ attributes.addClass('lab-card-wrap') }}>
  <a href="{{ url }}" class="lab-card lab-card--media" rel="bookmark">
    <div class="lab-card__media" aria-hidden="true">
      {% if detg.has_image %}
        {{ content.field_imagem }}
      {% else %}
        <div class="lab-card__placeholder">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.384-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/>
          </svg>
        </div>
      {% endif %}
    </div>
    <div class="lab-card__body">
      <h3 class="lab-name">{{ detg.sigla ?: detg.name }}</h3>
      {% if detg.sigla %}
        <p class="lab-desc">{{ detg.name }}</p>
      {% endif %}
      {% if detg.summary %}
        <p class="lab-summary">{{ detg.summary }}</p>
      {% endif %}
      {% if detg.coord %}
        <p class="lab-coord">{{ 'Responsável'|t }}: {{ detg.coord }}</p>
      {% endif %}
      <span class="lab-more">{{ 'Saiba mais'|t }} →</span>
    </div>
  </a>
</article>
