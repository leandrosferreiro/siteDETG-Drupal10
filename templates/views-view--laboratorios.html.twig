{#
/**
 * @file
 * View Laboratórios — grid de cards no estilo html_DETG.
 */
#}
{%
  set classes = [
    'view',
    'detg-view',
    'view-laboratorios',
    'view-id-' ~ id,
    'view-display-id-' ~ display_id,
    dom_id ? 'js-view-dom-id-' ~ dom_id,
  ]
%}
{% set is_block = display_id starts with 'block' %}
<section id="laboratorios"{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {% if is_block %}
    <div class="section-heading section-heading--center">
      <h2 class="section-heading__title">{{ title|default('Laboratórios'|t) }}</h2>
      <a href="{{ path('view.laboratorios.page_1') }}" class="section-heading__more">{{ 'Ver todos'|t }} →</a>
    </div>
  {% else %}
    <div class="page-intro">
      <h1 class="page-intro__title">{{ title|default('Laboratórios'|t) }}</h1>
      <p class="page-intro__lead">{{ 'Conheça a infraestrutura de pesquisa e ensino do DETG.'|t }}</p>
    </div>
  {% endif %}
  {{ title_suffix }}

  {% if header %}
    <div class="view-header">{{ header }}</div>
  {% endif %}

  {% if exposed %}
    <div class="view-filters">{{ exposed }}</div>
  {% endif %}

  {% if rows %}
    <div class="labs-grid detg-view__rows">{{ rows }}</div>
  {% elseif empty %}
    <div class="detg-view__empty">
      {{ empty }}
      <p>{{ 'Nenhum laboratório publicado ainda.'|t }}</p>
    </div>
  {% endif %}

  {% if pager %}
    <div class="detg-view__pager">{{ pager }}</div>
  {% endif %}

  {% if more %}
    {{ more }}
  {% endif %}
</section>
